---
import type {GetStaticPaths} from 'astro';
import LayoutBase from '../../layouts/LayoutBase.astro';
import {ArticlePage, components} from '../../components/pages/article';
import {
  AUTHOR,
  getArticleHref,
  getArticles,
  type Article,
} from '../../lib/articles';

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: {slug: article.slug},
    props: {article},
  }));
}) satisfies GetStaticPaths;

type Props = {
  article: Article;
};

const {article} = Astro.props;
const {title, description, publishedAt, updatedAt, tags} = article.data;
const {Content, headings} = await article.render();

const url = new URL(getArticleHref(article), Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {'@type': 'Person', name: AUTHOR.name, url: AUTHOR.url},
  image: new URL('/assets/images/og.png', Astro.site).href,
  keywords: tags.join(', '),
  url: url.href,
  mainEntityOfPage: {'@type': 'WebPage', '@id': url.href},
};
---

<LayoutBase title={title} description={description} type='article'>
  <Fragment slot='head'>
    <meta name='author' content={AUTHOR.name} />
    <meta name='keywords' content={tags.join(', ')} />
    <meta
      property='article:published_time'
      content={publishedAt.toISOString()}
    />
    {
      updatedAt && (
        <meta
          property='article:modified_time'
          content={updatedAt.toISOString()}
        />
      )
    }
    <meta property='article:author' content={AUTHOR.url} />
    {tags.map((tag) => <meta property='article:tag' content={tag} />)}
    <script
      is:inline
      type='application/ld+json'
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <ArticlePage
    title={title}
    description={description}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    tags={tags}
    headings={headings}
    client:load
  >
    <Content components={components} />
  </ArticlePage>
</LayoutBase>
